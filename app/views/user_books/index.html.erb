<% content_for :description do %>マイページです。ユーザーの登録した本の情報の一覧を検索できます。<% end %>

<div class="user-books-page">
  <ul class="books-tabs">
    <li>
      <%= link_to '本の新規登録', new_user_book_path, data: {"turbolinks"=>false} %>
    </li>
    <li class="active">
      <%= link_to 'マイページ', user_books_path, data: {"turbolinks"=>false} %>
    </li>
  </ul>

  <div class="mypage-actions">
    <%= button_to 'ログアウト', destroy_user_session_path, method: :delete, class: 'btn btn-default logout-button' %>
  </div>

  <div class="user-book-search">
    <div class="search-form">
      <h1>登録した本の検索</h1>

      <%= form_with url: search_path, method: :get, local: true do |f| %>
        <%= f.text_field :keyword, value: @keyword, placeholder: "タイトル・著者名" %><br>

        <%= f.collection_select :category_ids, Category.all, :id, :category_name,
          include_blank: "カテゴリーを選択して下さい", selected: @category_ids %><br>

        <div id="feeling_stars"></div>

        <div id="feeling_search">
          <% if @feeling_category_ids.empty? %>
            <%= f.collection_select "dummy_ids[]",
              FeelingCategory.where(user_id: current_user.id).or(FeelingCategory.where(user_id: nil)).order(:user_id, :id),
              :id, :feeling_after_reading,
              { include_blank: "読後感を選択して下さい" },
              { id: "feeling_stars" } %>が

            <%= f.select "dummy_stars[]",
              [["高評価（☆３以上）", "stars_high"], ["低評価（☆２以下）", "stars_low"],
              ["☆５のみ", "stars_5"], ["☆４のみ", "stars_4"], ["☆３のみ", "stars_3"],
              ["☆２のみ", "stars_2"], ["☆１のみ", "stars_1"]],
              include_blank: "選択してください" %>
          <% end %>

          <% @feeling_category_ids.each_with_index do |feeling_category_id, index| %>
            <%= f.collection_select "dummy_ids[]",
              FeelingCategory.where(user_id: current_user.id).or(FeelingCategory.where(user_id: nil)).order(:user_id, :id),
              :id, :feeling_after_reading,
              include_blank: "読後感を選択して下さい",
              selected: feeling_category_id %>が

            <%= f.select "dummy_stars[]",
              [["高評価（☆３以上）", "stars_high"], ["低評価（☆２以下）", "stars_low"],
              ["☆５のみ", "stars_5"], ["☆４のみ", "stars_4"], ["☆３のみ", "stars_3"],
              ["☆２のみ", "stars_2"], ["☆１のみ", "stars_1"]],
              include_blank: "選択してください",
              selected: @stars[index] %>
          <% end %>
        </div>

        <%= button_tag type: "submit", class: "btn btn-default search" do %>
          <i class="fa fa-search"></i>検索
        <% end %>
      <% end %>

      <%= link_to '検索条件をリセット', user_books_path, data: { "turbolinks": false } %>
    </div>
  </div>

  <% if @userBooks.present? %>
    <div class="user-book-results-list">
      <% @userBooks.each do |user_book| %>
        <article class="user-book-result-single">
          <div class="user-book-result-media">
            <% if user_book.user_book_image.attached? %>
              <%= image_tag user_book.user_book_image, class: 'user-book-result-image' %>
            <% else %>
              <div class="user-book-result-image user-book-result-image-placeholder">NO IMAGE</div>
            <% end %>
          </div>

          <div class="user-book-result-show">
            <h3><%= user_book.title %></h3>
            <p>著者</p>
            <p><%= user_book.author %></p>
            <div class="feeling_category">
              <label>読後感</label>
              <% user_book.user_feeling_categories.each do |ufc| %>
                <div
                  class="feeling_after"
                  data-stars="<%= ufc.stars %>"
                  data-feeling-after-reading="<%= ufc.feeling_category&.feeling_after_reading %>">
                </div>
              <% end %>
            </div>
          </div>

          <div class="submit user-book-result-actions">
            <%= link_to '詳細・編集', edit_user_book_path(user_book), class: 'btn btn-default edit' %>
            <%= button_to '削除', user_book_path(user_book),
              method: :delete,
              class: 'btn btn-default delete-button',
              form: { data: { turbo_confirm: '削除してもよろしいですか？' } } %>
          </div>
        </article>
      <% end %>
    </div>
  <% else %>
    <div class="user-book-empty">
      <p>登録されている本はまだありません。</p>
    </div>
  <% end %>
</div>

<%= vite_javascript_tag 'feeling_stars_search_vue' %>
<%= vite_javascript_tag 'feeling_index_vue' %>
