<% content_for :description do %>登録されている読後感の編集ページです。<% end %>   
<div class="feeling-categories-wrapper">
  <div class="container">
    <div class="feeling-categories-page feeling-categories-edit-page">
      <div class="feeling-categories-hero">
        <p class="feeling-categories-kicker">Feeling Categories</p>
        <h1>読後感を編集する</h1>
        <p class="feeling-categories-lead">言葉を整えて、記録の粒度を揃えます。</p>
      </div>

      <section class="feeling-categories-panel edit-form-panel">
        <div class="panel-header">
          <h2>編集フォーム</h2>
        </div>
        <%= form_tag(feeling_categories_update_path, method: :post, class: "create-feeling-category-form") do %>
          <label class="form-label" for="edit_feeling_after_reading">読後感名</label>
          <input id="edit_feeling_after_reading" type="text" name="feeling_after_reading" value="<%= @feelingCategory.feeling_after_reading %>" class="form-input">
          <input type="hidden" name="feeling_category_id" value="<%= @feelingCategory.id %>">
          <div class="create-button">
            <input type="submit" value="更新する" class="btn btn-default edit">
          </div>
        <% end %>
      </section>

      <div class="page-links">
        <%= link_to '読後感の一覧に戻る', feeling_categories_index_url, class: "page-link" %>
      </div>
    </div>
  </div>
</div>
